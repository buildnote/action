{
  "name": "buildnote-action",
  "version": "2.0.0",
  "main": "dist/index.js",
  "repository": "git@github.com:buildnote/action",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf coverage build tmp dist",
    "prebuild": "yarn run clean",
    "build": "ncc build src/main.ts -e typescript -o dist --source-map",
    "postbuild": "node scripts/replace-ts.js",
    "lint": "eslint .",
    "test": "jest --coverage src/**/*",
    "test:watch": "jest --watch",
    "postinstall": "husky install .github/husky"
  },
  "lint-staged": {
    "src/**/*.{yaml,yml}": "prettier --write",
    "src/**/*.{js,ts}": "eslint --cache --fix",
    "*.md": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/dedent": "^0.7.0",
    "@types/jest": "~30.0.0",
    "@types/node": "~24.13.3",
    "@typescript-eslint/eslint-plugin": "~8.68.0",
    "@typescript-eslint/parser": "~8.68.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "~29.16.5",
    "globals": "^17.11.0",
    "husky": "^8.0.3",
    "jest": "~30.5.0",
    "jest-playback": "^3.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rimraf": "~6.1.3",
    "ts-jest": "~29.4.12",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^6.0.1",
    "@actions/io": "^2.0.0",
    "@actions/tool-cache": "^3.0.1",
    "actions-parsers": "^1.0.2",
    "ansi-to-html": "^0.7.2",
    "dedent": "^0.7.0",
    "got": "^11.8.6",
    "runtypes": "^6.7.0",
    "semver": "^7.6.0",
    "ts-invariant": "^0.10.3",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=24"
  }
}
